# Configuración de Firebase v10+ (Consola de Firebase)
VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Teléfono de WhatsApp para pedidos y cotizaciones (con código de país, sin espacios ni signos +)
# Ejemplo para México: 5215555555555 | Ejemplo para Colombia: 573001234567
VITE_WHATSAPP_PHONE_NUMBER=5215555555555
