# Chatbot: deshabilitado en producción; desarrollo y ?chatbot=test permiten pruebas.
VITE_CHATBOT_ENABLED=false
VITE_LEGACY_QUOTER=false
# Opcional. Sin endpoint, la propuesta se simula y se indica en la interfaz.
VITE_QUOTE_ENDPOINT=

# Firebase del navegador (no contiene credenciales de servidor).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo servidor. Nunca usar prefijo VITE_ para estos secretos.
PAYMENT_PROVIDER=none
PAYMENT_TEST_MODE=true
APP_URL=https://www.inversati.com
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
